# ─── Maintenance Mode Toggle ──────────────────────────────────────────────────
# true = Maintenance Mode ON, false = Normal website
MAINTENANCE_MODE=false

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:2717/wellmeds

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your_32_character_long_production_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cookiesecretkey12345!@#

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yourkeysecret
RAZORPAY_WEBHOOK_SECRET=yourwebhooksecret

# ─── Cloudinary Media Storage ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=yourcloudinarycloudname
CLOUDINARY_API_KEY=yourcloudinaryapikey
CLOUDINARY_API_SECRET=yourcloudinaryapisecret

# ─── Resend / SMTP Email Configuration ─────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
EMAIL_FROM="WellMeds <onboarding@resend.dev>"
ADMIN_EMAIL=admin@wellmeds.in

# ─── Google OAuth Credentials ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=yourgoogleclientid.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=yourgoogleclientsecret

# ─── Google Maps Platform Configuration ───────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here
GOOGLE_DISTANCE_MATRIX_API_KEY=your_google_distance_matrix_api_key_here
GOOGLE_DIRECTIONS_API_KEY=your_google_directions_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Pharmacy Store Location & Delivery Settings ──────────────────────────────
STORE_LATITUDE=18.5590
STORE_LONGITUDE=73.7868
STORE_ADDRESS=Shop No 3, Echelon Apartment, Baner - Pashan Link Rd, Baner, Pune
STORE_PINCODE=411021

# ─── Web Push VAPID Configuration ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@wellmeds.in
